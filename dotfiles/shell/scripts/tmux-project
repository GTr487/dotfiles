#!/usr/bin/env bash

PROJECT_DIRS=(
  "$HOME/dev"
  )

STATUS_COMMAND="status-project"

pick_project() {
  local roots=("$@")

  if command -v "$STATUS_COMMAND" &>/dev/null; then
    # Use status script as preview
    find "${roots[@]}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null \
      | fzf --prompt="Select project: " \
            --preview="$STATUS_COMMAND --path={}" \
            --preview-window=right:60%:wrap
  else
    # Fallback: simple directory listing preview
    find "${roots[@]}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null \
      | fzf --prompt="Select project: " \
            --preview="ls -la {}" \
            --preview-window=right:60%:wrap
  fi
}

open_session() {
  local dir="$1"
  [ -z "$dir" ] && exit 1

  local session
  session=$(basename "$dir")

  if tmux has-session -t "$session" 2>/dev/null; then
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach -t "$session"
    fi

  else
    tmux new-session -ds "$session" -c "$dir"
    
    # Check if status command is available in PATH
    if command -v "$STATUS_COMMAND" &>/dev/null; then
      # Verify it's a git repository before showing status
      if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
        tmux send-keys -t "$session" "$STATUS_COMMAND" C-m
      fi
    fi

    # tmux send-keys -t "$session" "nvim" C-m
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach -t "$session"
    fi
  fi
}

if [ "$1" = "-fzf" ]; then
  shift
  roots=("$@")
  if [ ${#roots[@]} -eq 0 ]; then
    roots=("${PROJECT_DIRS[@]}")
  fi
  project=$(pick_project "${roots[@]}")
  [ -n "$project" ] && open_session "$project"

else
  if [ "$1" = "." ]; then
    open_session "$(pwd)"
    exit 0
  fi

  if [ -n "$1" ] && [ -d "$1" ]; then
    open_session "$1"
    exit 0
  fi

  project=$(pick_project "${PROJECT_DIRS[@]}")
  [ -n "$project" ] && open_session "$project"
fi
